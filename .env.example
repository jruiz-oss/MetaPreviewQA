# ─── Core ────────────────────────────────────────────────────────────────────
# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Shared password the team types on the login screen
SITE_PASSWORD=your-team-password-here

# Random string used as the auth cookie value — generate any long random string
AUTH_TOKEN=change-this-to-a-long-random-string

# ─── Meta (Facebook) Graph API ───────────────────────────────────────────────
# Long-lived system-user / user token with ads_read (or ads_management).
# Used to pull campaign ads + creative. NOTE: Meta tokens expire — when QA starts
# failing with "code 190", regenerate this in Business Settings and redeploy.
META_ACCESS_TOKEN=

# ─── Google (Drive + Docs) OAuth ─────────────────────────────────────────────
# From a Google Cloud OAuth 2.0 Client (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on the OAuth client, e.g.
# http://localhost:3000/api/google/callback
# (prod: https://<your-domain>/api/google/callback)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Refresh token minted on first connect — the fallback used when no token is
# stored in Redis (below). Generated by visiting /api/google/connect once.
GOOGLE_REFRESH_TOKEN=

# ─── Deployment ──────────────────────────────────────────────────────────────
# Public base URL used to build the OAuth redirect links. Defaults to
# http://localhost:3000 for local dev; set to your deployed origin in prod.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Optional: Upstash Redis (shared Google token store) ─────────────────────
# When set, the Google refresh token is shared across all serverless instances
# so one reconnect updates everyone. If unset, GOOGLE_REFRESH_TOKEN is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Optional: debug logging ─────────────────────────────────────────────────
# Set to 1 to re-enable verbose server logs (folder/asset tracing, token usage,
# model reasoning). Leave unset in production.
QA_DEBUG=
